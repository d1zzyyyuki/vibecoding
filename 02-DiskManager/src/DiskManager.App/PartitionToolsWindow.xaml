<Window x:Class="DiskManager.PartitionToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分区工具"
        Width="720" Height="590" MinWidth="680" MinHeight="540"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" ClipToBounds="True">
        <Rectangle Fill="{StaticResource WindowBg}" />
        <Ellipse Width="560" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-160,0,0"
                 Fill="{StaticResource GlowWarm}" IsHitTestVisible="False" />
        <Ellipse Width="460" Height="340" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-170"
                 Fill="{StaticResource GlowRose}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="分区工具" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextTitle}" />
                    <TextBlock x:Name="ModeBadge" Text="CREATE" FontSize="9" Foreground="{StaticResource TextFaint}" Margin="10,2,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseTitleBarButton}" Click="Close_Click" Margin="0,0,12,0" ToolTip="关闭" Content="✕" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Border Grid.Row="1" Margin="18,6,18,18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle" Text="新建分区" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextTitle}" />
                        <TextBlock x:Name="HeaderSubtitle" Text="在所选磁盘的未分配空间创建分区；执行前需要确认。"
                                   FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0CFFFFFF" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TargetText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="TargetDetail" Text="—" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel x:Name="SizePanel">
                            <TextBlock Text="新分区大小" FontSize="10" Foreground="{StaticResource TextFaint}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SizeBox" Style="{StaticResource DarkTextBox}" Text="512" Height="36" VerticalContentAlignment="Center" />
                                <TextBlock x:Name="SizeUnitText" Grid.Column="1" Text="MB" FontSize="10" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock x:Name="SizeRangeText" Grid.Column="2" Text="(0-0 MB)" FontSize="10.5" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="卷标" FontSize="10" Foreground="{StaticResource TextFaint}" />
                                <TextBox x:Name="LabelBox" Style="{StaticResource DarkTextBox}" Text="DATA" Height="36" VerticalContentAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" x:Name="LetterPanel">
                                <TextBlock Text="盘符（留空自动）" FontSize="10" Foreground="{StaticResource TextFaint}" />
                                <TextBox x:Name="LetterBox" Style="{StaticResource DarkTextBox}" Height="36" VerticalContentAlignment="Center" MaxLength="1" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="文件系统：NTFS（当前只开放 NTFS）" FontSize="10" Foreground="{StaticResource TextFaint}" Margin="0,12,0,0" />

                        <Border x:Name="WarningBorder" Background="#12E8B45A" BorderBrush="#33E8B45A" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,14,0,0">
                            <TextBlock x:Name="WarningText" FontSize="10.5" Foreground="{StaticResource Warning}" TextWrapping="Wrap" LineHeight="17" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="就绪" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                            <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentOrange}" Background="{StaticResource Track}" BorderThickness="0" Margin="0,7,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,7" Margin="0,0,8,0" Click="Close_Click" />
                            <Button x:Name="StartButton" Content="开始" Style="{StaticResource PrimaryButton}" Padding="20,7" Click="Start_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ConfirmPanel" Panel.ZIndex="20" Background="#B8000000" Visibility="Collapsed">
            <Border Width="520" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelStrong}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1"
                    CornerRadius="14" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="确认分区操作" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextTitle}" />
                    <TextBlock x:Name="ConfirmSummaryText" FontSize="11.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="19" />
                    <Border Background="#0CFFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,14,0,0">
                        <TextBlock x:Name="ConfirmWarningText" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="17" />
                    </Border>
                    <CheckBox x:Name="RiskCheck" Content="我已备份数据，并了解操作风险" Foreground="{StaticResource TextPrimary}" FontSize="11"
                              Margin="0,14,0,0" Checked="RiskCheck_Changed" Unchecked="RiskCheck_Changed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,7" Margin="0,0,8,0" Click="ConfirmCancel_Click" />
                        <Button x:Name="ConfirmButton" Content="确认执行" Style="{StaticResource PrimaryButton}" Padding="20,7" IsEnabled="False" Click="Confirm_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
