<Application x:Class="DiskManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DiskManager.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:InverseNullToVisibilityConverter x:Key="InvNullToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
