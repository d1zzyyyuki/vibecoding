{
  "manifest_version": 3,
  "name": "HLTV-AdBlocker · 反立即捡钱插件",
  "short_name": "HLTV AdBlock",
  "version": "1.1.2",
  "description": "在 HLTV.org 屏蔽赌博、弹窗和背景广告，并为新闻、评论、选手和战队补充中文参考。",
  "homepage_url": "https://github.com/d1zzyyyuki/vibecoding/tree/main/03-HLTV-AdBlocker",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.hltv.org/*",
    "https://api.mymemory.translated.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "hltv_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hltv.org/*"
      ],
      "js": [
        "content.js",
        "zh.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "HLTV-AdBlocker · 反立即捡钱插件 · by cbd"
  }
}
