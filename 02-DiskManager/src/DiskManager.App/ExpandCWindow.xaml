<Window x:Class="DiskManager.ExpandCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C 盘扩容"
        Width="820" Height="700" MinWidth="760" MinHeight="640"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
        <Rectangle Fill="{StaticResource WindowBg}" />
        <Image Source="/Assets/Furina.jpg" Stretch="UniformToFill" Opacity="0.20" IsHitTestVisible="False" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0050B16" Offset="0" />
                    <GradientStop Color="#D8071424" Offset="0.6" />
                    <GradientStop Color="#E6081728" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="C 盘扩容" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextTitle}" />
                    <TextBlock Text="EXPAND C · DISKMANAGER" FontSize="9" Foreground="{StaticResource TextFaint}" Margin="10,2,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseTitleBarButton}" Click="Close_Click" Margin="0,0,12,0" ToolTip="关闭" Content="✕" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Border Grid.Row="1" Margin="18,6,18,18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DiskTitle" Text="磁盘" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextTitle}" />
                            <TextBlock x:Name="DiskDetail" Text="—" FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="可扩容约" FontSize="10" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="MaxText" Text="0 MB" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SystemBlue}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#0C58C7FF" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="扩容大小" FontSize="10" Foreground="{StaticResource TextFaint}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBox x:Name="GrowthBox" Style="{StaticResource DarkTextBox}" Width="150" Height="40" Padding="8,6" VerticalContentAlignment="Center" TextChanged="Growth_TextChanged" />
                                    <TextBlock x:Name="GrowthHint" Text="(0-0 MB)" FontSize="10" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,3">
                                <Button x:Name="UnitGbButton" Content="GB" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,6,0" Click="UnitGb_Click" />
                                <Button x:Name="UnitMbButton" Content="MB" Style="{StaticResource GhostButton}" Padding="12,5" Click="UnitMb_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="后续分区分摊" Style="{StaticResource SectionLabel}" FontSize="10" />
                        <TextBlock Text="AUTO ALLOCATION · 可手动修改" Style="{StaticResource BadgeText}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="分区" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="当前大小 / 空闲" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="收缩空间" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Grid.Row="1" Height="1" Background="{StaticResource Divider}" Margin="0,5,0,0" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="155">
                            <ItemsControl x:Name="DonorList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding LetterText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DetailText}" FontSize="9.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBox Text="{Binding Text, Mode=OneWay}" LostFocus="Donor_LostFocus" Foreground="{StaticResource TextPrimary}" Style="{StaticResource DarkTextBox}" Width="105" Height="38" Padding="8,6" VerticalContentAlignment="Center" TextAlignment="Right" />
                                                <TextBlock Text="{Binding UnitText}" FontSize="9.5" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="6,0,0,0" Width="24" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="TotalText" Text="已分配 0" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                            <TextBlock x:Name="BalanceText" Text="目标 0" FontSize="10.5" Foreground="{StaticResource SystemBlue}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock x:Name="StatusText" Text="填写扩容大小后自动分摊；也可以直接修改每个分区的收缩值。" FontSize="9.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="自动分配" Style="{StaticResource GhostButton}" Padding="14,6" Margin="0,0,8,0" Click="AutoAllocate_Click" />
                                <Button x:Name="NextButton" Content="生成计划" Style="{StaticResource PrimaryButton}" Padding="20,7" Click="Next_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
